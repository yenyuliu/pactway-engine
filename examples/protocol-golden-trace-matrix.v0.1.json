      "allowed": true,
      "requiredEvidence": [
        "required_input_resolved",
        "approval_card_hash"
      ]
    },
    {
      "id": "approval_to_gateway_execution",
      "from": "approval_ready",
      "to": "gateway_execution",
      "actor": "agent_gateway",
      "allowed": true,
      "requiredEvidence": [
        "exact_user_approval",
        "approved_action_intent_hash",
        "user_consent"
      ]
    },
    {
      "id": "gateway_execution_to_registry_event",
      "from": "gateway_execution",
      "to": "registry_event_history",
