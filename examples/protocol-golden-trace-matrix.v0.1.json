      "allowed": true,
      "requiredEvidence": [
        "gateway_result",
        "receipt_ref"
      ]
    },
    {
      "id": "terminal_result_to_restored_session",
      "from": "terminal_result",
      "to": "returned_session_current_state",
      "actor": "plugin_wallet_and_gateway",
