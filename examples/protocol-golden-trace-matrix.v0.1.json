  "claims": {
    "allowed": "Passes AgentPort protocol golden trace compatibility check.",
    "forbidden": [
      "AgentPort Certified",
      "AgentPort Verified",
      "Real-business proof",
      "Adapter coverage"
    ]
  },
  "boundaries": {
    "goldenTraceOnly": true,
    "realBusinessEvidence": false,
    "certification": false,
    "adapterCoverage": false
  }
