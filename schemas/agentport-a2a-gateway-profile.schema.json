{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentport.dev/schemas/agentport-a2a-gateway-profile.schema.json",
  "title": "AgentPort A2A Gateway Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "version",
    "artifactId",
    "summary",
    "boundary",
    "resources",
    "taskMapping",
    "requiredSequence",
    "forbiddenShortcuts",
    "resultSemantics",
    "conformance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "protocol": { "const": "agentport-a2a-gateway-profile" },
    "version": { "const": "0.1" },
    "artifactId": { "const": "agentport-a2a-gateway-profile.v0.1" },
    "summary": { "type": "string", "minLength": 1 },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a2aIsTransport",
        "agentPortIsGateway",
        "doesNotReplaceA2A",
        "doesNotCertify",
        "doesNotOwnBackend"
      ],
      "properties": {
        "a2aIsTransport": { "const": true },
        "agentPortIsGateway": { "const": true },
        "doesNotReplaceA2A": { "const": true },
        "doesNotCertify": { "const": true },
        "doesNotOwnBackend": { "const": true }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "purpose"],
        "properties": {
          "uri": {
            "enum": [
              "agentport://discovery",
              "agentport://open-standard",
              "agentport://action-model",
              "agentport://client-use-policy",
              "agentport://commitment-format",
              "agentport://gateway-trust-profile"
            ]
          },
          "purpose": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "taskMapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a2aTaskClass",
          "agentPortPrimitive",
          "stateChanging",
          "authorityRule",
          "receiptRule"
        ],
        "properties": {
          "a2aTaskClass": {
            "enum": [
              "business.info",
              "action.prepare",
              "action.lifecycle",
              "action.execute",
              "proof.receipt"
            ]
          },
          "agentPortPrimitive": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "get_business_info",
                "get_business_feed",
                "compile_action_intent",
                "get_action_intent_lifecycle",
                "poll_action_intent_lifecycles",
                "list_action_intent_result_deliveries",
                "get_action_intent_result_delivery",
                "ack_action_intent_result_delivery",
                "book_service",
                "cancel_service",
                "reschedule_service",
                "send_ticket",
                "ActionReceipt"
              ]
            }
          },
          "stateChanging": { "type": "boolean" },
          "authorityRule": { "type": "string", "minLength": 1 },
          "receiptRule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requiredSequence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenShortcuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resultSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskStateRule", "businessOutcomeRule", "receiptRule"],
      "properties": {
        "taskStateRule": { "type": "string", "minLength": 1 },
        "businessOutcomeRule": { "type": "string", "minLength": 1 },
        "receiptRule": { "type": "string", "minLength": 1 }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldenTrace", "tamperTraceSuite", "certification"],
      "properties": {
        "goldenTrace": { "type": "string", "minLength": 1 },
        "tamperTraceSuite": { "type": "string", "minLength": 1 },
        "certification": { "const": false }
      }
    }
  }
}
