{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentport.dev/schemas/agentport-a2a-host-trace.schema.json",
  "title": "AgentPort A2A Host Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "id", "bindingArtifact", "expectedStatus", "scenario", "events", "boundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "type": { "const": "agentport.a2a_host_trace.v0.1" },
    "version": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "bindingArtifact": { "const": "artifacts/agentport-a2a-host-binding.v0.1.json" },
    "expectedStatus": { "enum": ["passed", "failed"] },
    "expectedFailureIds": { "type": "array", "items": { "type": "string" } },
    "scenario": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostTraceOnly", "certification", "realBusinessEvidence", "replacesA2A", "executesLiveNetwork"],
      "properties": {
        "hostTraceOnly": { "const": true },
        "certification": { "const": false },
        "realBusinessEvidence": { "const": false },
        "replacesA2A": { "const": false },
        "executesLiveNetwork": { "const": false }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "actor", "phase"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "actor": { "enum": ["frontier_host", "frontier_model", "agentport_plugin", "agentport_gateway"] },
        "phase": {
          "enum": [
            "classify_task",
            "discover_gateway",
            "read_action_model",
            "compile_action_intent",
            "render_approval",
            "execute_action",
            "receive_receipt",
            "ack_result_delivery",
            "present_result"
          ]
        },
        "a2aTaskClass": {
          "enum": ["business.info", "action.prepare", "action.execute", "proof.receipt"]
        },
        "agentPortPrimitive": { "type": "string", "minLength": 1 },
        "preservedFields": { "type": "array", "items": { "type": "string" } },
        "assertions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
