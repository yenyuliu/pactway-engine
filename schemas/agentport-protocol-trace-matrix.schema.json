{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentport.dev/schemas/agentport-protocol-trace-matrix.schema.json",
  "title": "AgentPort Protocol Golden Trace Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "allowed", "forbidden", "claims", "boundaries"],
  "properties": {
    "type": { "const": "agentport.protocol_golden_trace_matrix.v0.1" },
    "version": { "const": "0.1" },
    "allowed": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceRow" }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceRow" }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "string", "minLength": 1 },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldenTraceOnly", "realBusinessEvidence", "certification", "adapterCoverage"],
      "properties": {
        "goldenTraceOnly": { "const": true },
        "realBusinessEvidence": { "const": false },
        "certification": { "const": false },
        "adapterCoverage": { "const": false }
      }
    }
  },
  "$defs": {
    "traceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "actor", "allowed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "allowed": { "type": "boolean" },
        "requiredEvidence": { "type": "array", "items": { "type": "string" } },
        "rejectReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
